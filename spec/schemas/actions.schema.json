{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:website-companion:schema:actions:1.0",
  "title": "Website Companion actions resource",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resourceType", "resourceId", "version", "actions"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "resourceType": { "const": "actions" },
    "resourceId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,119}$" },
    "version": { "type": "string", "pattern": "^[A-Za-z0-9._+-]{1,80}$" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "title", "actionKind"],
      "properties": {
        "actionId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,119}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "actionKind": { "enum": ["item", "task", "preparation", "test", "reference"] },
        "category": { "type": "string", "maxLength": 160 },
        "summary": { "type": "string", "maxLength": 3000 },
        "details": { "type": "string", "maxLength": 30000 },
        "contentIds": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,119}$" }
        },
        "links": {
          "type": "array",
          "maxItems": 30,
          "items": { "$ref": "#/$defs/link" }
        },
        "visibility": { "$ref": "urn:website-companion:schema:condition:1.0#/$defs/condition" },
        "flags": {
          "type": "object",
          "maxProperties": 30,
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]{1,79}$" },
          "additionalProperties": { "type": "boolean" }
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    }
  }
}
