{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:website-companion:schema:condition:1.0",
  "title": "Website Companion bounded local condition",
  "$defs": {
    "scalar": {
      "oneOf": [
        { "type": "string", "maxLength": 300 },
        { "type": "boolean" },
        { "type": "integer" }
      ]
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["choiceId", "operator"],
      "allOf": [
        {
          "if": {
            "properties": { "operator": { "enum": ["truthy", "falsy"] } },
            "required": ["operator"]
          },
          "then": { "properties": { "value": false } },
          "else": { "properties": { "value": true }, "required": ["value"] }
        }
      ],
      "properties": {
        "choiceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
        "operator": {
          "enum": ["equals", "not-equals", "contains", "not-contains", "truthy", "falsy"]
        },
        "value": { "$ref": "#/$defs/scalar" }
      }
    },
    "all": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all"],
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/condition" }
        }
      }
    },
    "any": {
      "type": "object",
      "additionalProperties": false,
      "required": ["any"],
      "properties": {
        "any": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/condition" }
        }
      }
    },
    "not": {
      "type": "object",
      "additionalProperties": false,
      "required": ["not"],
      "properties": {
        "not": { "$ref": "#/$defs/condition" }
      }
    },
    "condition": {
      "oneOf": [
        { "$ref": "#/$defs/predicate" },
        { "$ref": "#/$defs/all" },
        { "$ref": "#/$defs/any" },
        { "$ref": "#/$defs/not" }
      ]
    }
  }
}
