{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:website-companion:schema:catalogue:1.0",
  "title": "Website Companion catalogue resource",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resourceType", "resourceId", "version", "regions", "offers"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "resourceType": { "const": "catalogue" },
    "resourceId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,119}$" },
    "version": { "type": "string", "pattern": "^[A-Za-z0-9._+-]{1,80}$" },
    "regions": {
      "type": "array",
      "maxItems": 250,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z0-9-]{2,20}$" }
    },
    "offers": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/offer" }
    }
  },
  "$defs": {
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offerId", "offerKind", "title", "vendor", "url"],
      "properties": {
        "offerId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,119}$" },
        "offerKind": { "enum": ["product", "test", "tool", "service", "reference"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "actionId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,119}$" },
        "category": { "type": "string", "maxLength": 160 },
        "description": { "type": "string", "maxLength": 5000 },
        "vendor": { "type": "string", "minLength": 1, "maxLength": 200 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "cartUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "regions": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z0-9-]{2,20}$" }
        },
        "price": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency"],
          "properties": {
            "amount": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]{1,4})?$" },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
          }
        },
        "recommendationGroup": { "type": "string", "maxLength": 160 },
        "rank": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "sex": { "type": "string", "maxLength": 80 },
        "topic": { "type": "string", "maxLength": 160 },
        "visibility": { "$ref": "urn:website-companion:schema:condition:1.0#/$defs/condition" }
      }
    }
  }
}
