{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:website-companion:schema:choices:1.0",
  "title": "Website Companion local choices resource",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resourceType", "resourceId", "version", "choiceSets"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "resourceType": { "const": "choices" },
    "resourceId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,119}$" },
    "version": { "type": "string", "pattern": "^[A-Za-z0-9._+-]{1,80}$" },
    "choiceSets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/choiceSet" }
    }
  },
  "$defs": {
    "scalar": {
      "oneOf": [
        { "type": "string", "maxLength": 300 },
        { "type": "boolean" },
        { "type": "integer" }
      ]
    },
    "choiceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["choiceId", "title", "input", "required", "localOnly", "options"],
      "properties": {
        "choiceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "description": { "type": "string", "maxLength": 1500 },
        "input": { "enum": ["single", "multiple", "boolean"] },
        "required": { "type": "boolean" },
        "localOnly": { "const": true },
        "default": {
          "oneOf": [
            { "$ref": "#/$defs/scalar" },
            {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/scalar" }
            }
          ]
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/option" }
        },
        "visibility": { "$ref": "urn:website-companion:schema:condition:1.0#/$defs/condition" }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "$ref": "#/$defs/scalar" },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "maxLength": 1000 }
      }
    }
  }
}
