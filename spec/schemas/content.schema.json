{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:website-companion:schema:content:1.0",
  "title": "Website Companion content resource",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resourceType", "resourceId", "version", "entries"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "resourceType": { "const": "content" },
    "resourceId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,119}$" },
    "version": { "type": "string", "pattern": "^[A-Za-z0-9._+-]{1,80}$" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentId", "kind"],
      "properties": {
        "contentId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,119}$" },
        "kind": { "enum": ["text", "notice", "instruction", "reference"] },
        "title": { "type": "string", "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 1000 },
        "body": { "type": "string", "maxLength": 30000 },
        "links": {
          "type": "array",
          "maxItems": 30,
          "items": { "$ref": "#/$defs/link" }
        },
        "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    }
  }
}
